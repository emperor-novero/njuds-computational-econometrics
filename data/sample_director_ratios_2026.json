  "metadata": {
    "title": "State of New Jersey Chapter 123 Equalization Director Ratios and Tax Rates (2026 Table of Equalized Valuations)",
    "statute": "N.J.S.A. 54:51A-6 (Chapter 123 of the Laws of 1973)",
    "promulgating_agency": "State of New Jersey Department of the Treasury, Division of Taxation",
    "tax_year": 2026,
    "curated_by": "NJUDS Computational Spatial Econometrics Lab",
    "lead_researcher": "Dorian Mario Gonzalez",
    "description": "Catalog of certified Director Ratios (average assessment ratios derived from SR1A real property deed transactions), statutory Chapter 123 appeal corridors (lower limit = R * 0.85, upper limit = R * 1.15), general property tax rates, and computed effective tax rates across key urban and suburban taxing districts.",
    "tolerance_percentage": 15.0,
    "corridor_formula": {
      "lower_limit": "directors_ratio * 0.85",
      "upper_limit": "directors_ratio * 1.15"
    }
  },
